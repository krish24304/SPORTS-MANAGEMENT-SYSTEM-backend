generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name     String
  email    String  @unique
  password String
  rollNo   String?
  phone    String?
  role     String // student, staff, admin

  idCard      String?
  idCardPhoto String?

  createdAt DateTime @default(now())

  bookings         Booking[]
  requests         Request[]
  issuedGears      IssuedGear[]
  issueRequests    IssueRequest[]
  Slot             Slot[]
  teamReservations TeamReservation[]
}

model Sport {
  id Int @id @default(autoincrement())

  name String @unique

  resourceType String @default("Court")

  hasSlotSystem Boolean @default(false)

  slotDurationMinutes Int @default(30)

  totalCourts     Int @default(1)
  availableCourts Int @default(1)

  maintenance        Boolean @default(false)
  maintenanceMessage String?

  createdAt DateTime @default(now())

  slots         Slot[]
  gears         Gear[]
  bookings      Booking[]
  notices       Notice[]
  resourceUnits ResourceUnit[]

  hasDynamicBooking Boolean @default(true)

  teamReservations TeamReservation[]

  slotCapacity Int @default(1)
}

// Only for slot-based sports
model Slot {
  id Int @id @default(autoincrement())

  sportId Int
  sport   Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime

  slotType   String  @default("available") // "available", "team_reserved"
  isActive   Boolean @default(true)
  bookedById Int?
  bookedBy   User?   @relation(fields: [bookedById], references: [id], onDelete: SetNull)

  bookings Booking[]

  maxCapacity Int @default(1)

  bookedCount Int @default(0)

  createdAt DateTime @default(now())

  @@unique([sportId, startTime, endTime])
}

model Gear {
  id Int @id @default(autoincrement())

  name        String
  description String?

  sportId Int
  sport   Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  totalQuantity     Int
  availableQuantity Int

  damagedQuantity Int @default(0)

  issuedGears IssuedGear[]

  createdAt DateTime @default(now())
}

