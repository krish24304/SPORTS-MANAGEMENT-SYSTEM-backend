generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}
model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  role      String
  bookings  Booking[]
}

model Sport {
  id              Int      @id @default(autoincrement())
  name            String
  totalGear       Int
  availableGear   Int
  slots           Slot[]
}

model Slot {
  id         Int      @id @default(autoincrement())
  time       String
  available  Boolean

  sportId    Int
  sport      Sport    @relation(fields: [sportId], references: [id])

  bookings   Booking[]
}

model Booking {
  id       Int    @id @default(autoincrement())

  userId   Int
  slotId   Int

  user     User   @relation(fields: [userId], references: [id])
  slot     Slot   @relation(fields: [slotId], references: [id])
}