generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  password         String
  role             String
  idCard           String?
  idCardPhoto      String?
  createdAt        DateTime          @default(now())
  phone            String?
  rollNo           String?
  bookings         Booking[]
  issueRequests    IssueRequest[]
  issuedGears      IssuedGear[]
  requests         Request[]
  Slot             Slot[]
  teamReservations TeamReservation[]
}

model Sport {
  id                  Int               @id @default(autoincrement())
  name                String            @unique
  hasSlotSystem       Boolean           @default(false)
  slotDurationMinutes Int               @default(30)
  totalCourts         Int               @default(1)
  availableCourts     Int               @default(1)
  maintenance         Boolean           @default(false)
  maintenanceMessage  String?
  createdAt           DateTime          @default(now())
  hasDynamicBooking   Boolean           @default(true)
  hasTeamSlots        Boolean           @default(false)
  bookings            Booking[]
  gears               Gear[]
  notices             Notice[]
  resourceUnits       ResourceUnit[]
  resourceType        String @default("Court")
  slots               Slot[]
  teamReservations    TeamReservation[]
}

model Slot {
  id          Int       @id @default(autoincrement())
  sportId     Int
  startTime   DateTime
  endTime     DateTime
  slotType    String    @default("available")
  isActive    Boolean   @default(true)
  bookedById  Int?
  createdAt   DateTime  @default(now())
  maxCapacity Int       @default(1)
  bookedCount Int       @default(0)
  bookings    Booking[]
  bookedBy    User?     @relation(fields: [bookedById], references: [id])
  sport       Sport     @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([sportId, startTime, endTime])
}

model Gear {
  id                Int          @id @default(autoincrement())
  name              String
  description       String?
  sportId           Int
  totalQuantity     Int
  availableQuantity Int
  damagedQuantity   Int          @default(0)
  createdAt         DateTime     @default(now())
  sport             Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)
  issuedGears       IssuedGear[]
}

model Booking {
  id                Int       @id @default(autoincrement())
  userId            Int
  sportId           Int
  slotId            Int?
  bookingType       String    @default("slot")
  gearsBooked       Json?
  resourcesBooked   Json?
  active            Boolean   @default(true)
  status            String    @default("active")
  bookedAt          DateTime  @default(now())
  startTime         DateTime?
  endTime           DateTime?
  cancelledAt       DateTime?
  notes             String?
  returnRequestedAt DateTime?
  returnedAt        DateTime?
  returnedById      Int?
  slot              Slot?     @relation(fields: [slotId], references: [id])
  sport             Sport     @relation(fields: [sportId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceUnitId    Int?

  resourceUnit ResourceUnit? @relation(fields: [resourceUnitId], references: [id])
}

model IssuedGear {
  id                 Int       @id @default(autoincrement())
  userId             Int
  gearId             Int
  quantityIssued     Int
  issueDate          DateTime  @default(now())
  expectedReturnDate DateTime?
  returnDate         DateTime?
  status             String    @default("issued")
  condition          String?
  issueNotes         String?
  createdAt          DateTime  @default(now())
  gear               Gear      @relation(fields: [gearId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IssueRequest {
  id             Int       @id @default(autoincrement())
  userId         Int
  sportName      String
  gearsRequested Json
  status         String    @default("pending")
  requestedAt    DateTime  @default(now())
  approvedAt     DateTime?
  approvalNotes  String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Request {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String   @default("sport")
  createdAt DateTime @default(now())
  sportId   Int?
  sport     Sport?   @relation(fields: [sportId], references: [id])
}

model TeamReservation {
  id Int @id @default(autoincrement())

  teamName String
  purpose  String?

  sportId Int

  startDateTime      DateTime
  endDateTime        DateTime
  durationMinutes    Int
  reservationMessage String?

  bookedById Int?

  createdAt DateTime @default(now())

  sport Sport @relation(fields: [sportId], references: [id])

  bookedBy User? @relation(fields: [bookedById], references: [id])

  resourcesUnit TeamReservationResource[]
}

model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model ResourceUnit {
  id Int @id @default(autoincrement())

  sportId Int

  name String

  type String

  status String @default("available")

  createdAt DateTime @default(now())

  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  bookings Booking[]
  maintenanceMessage String?
  reservations TeamReservationResource[]
}

model TeamReservationResource {
  id Int @id @default(autoincrement())

  reservationId Int

  resourceUnitId Int

  reservation TeamReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  resourceUnit ResourceUnit @relation(fields: [resourceUnitId], references: [id], onDelete: Cascade)

  @@unique([reservationId, resourceUnitId])
}
