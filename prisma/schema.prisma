model ResourceUnit {
  id Int @id @default(autoincrement())

  sportId Int
  sport   Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  name String
  type String

  status             String  @default("available")
  maintenanceMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  reservationLinks TeamReservationResource[]
}

model Booking {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sportId Int
  sport   Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  slotId Int?
  slot   Slot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  bookingType String @default("slot") // "slot", "gear", "resource"

  gearsBooked     Json? // { gearId: quantity }
  resourcesBooked Json? // { resourceId: quantity }
  active          Boolean @default(true)
  status          String  @default("active") // active, cancelled, completed, returned

  bookedAt          DateTime  @default(now())
  startTime         DateTime?
  endTime           DateTime?
  cancelledAt       DateTime?
  returnRequestedAt DateTime?
  returnedAt        DateTime?
  returnedById      Int?

  notes          String?
  resourceUnitId Int?

  resourceUnit ResourceUnit? @relation(fields: [resourceUnitId], references: [id])
}

model IssuedGear {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  gearId Int
  gear   Gear @relation(fields: [gearId], references: [id], onDelete: Cascade)

  quantityIssued Int

  issueDate          DateTime  @default(now())
  expectedReturnDate DateTime?
  returnDate         DateTime?

  status String @default("issued") // issued, returned, damaged_reported

  condition String? // good, minor_damage, major_damage

  issueNotes String?

  createdAt DateTime @default(now())
}

model IssueRequest {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sportName      String
  gearsRequested Json // array of { gearId, quantity }

  status String @default("pending") // pending, approved, rejected

  requestedAt   DateTime  @default(now())
  approvedAt    DateTime?
  approvalNotes String?

  createdAt DateTime @default(now())
}

model Request {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String
  status  String @default("pending")

  createdAt DateTime @default(now())
}

model Notice {
  id Int @id @default(autoincrement())

  title   String
  message String

  sportId Int?
  sport   Sport? @relation(fields: [sportId], references: [id], onDelete: SetNull)

  type String @default("sport")

  createdAt DateTime @default(now())
}

model TeamReservation {
  id Int @id @default(autoincrement())

  teamName String

  purpose String?

  sportId Int

  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  startDateTime DateTime

  durationMinutes Int

  reservationMessage String?

  bookedById Int?

  bookedBy User? @relation(fields: [bookedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  resourcesUnit TeamReservationResource[]
}

model TeamReservationResource {
  id Int @id @default(autoincrement())

  reservationId Int

  reservation TeamReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  resourceUnitId Int

  resourceUnit ResourceUnit @relation(fields: [resourceUnitId], references: [id], onDelete: Cascade)

  @@unique([reservationId, resourceUnitId])
}

model Admin {
  id Int @id @default(autoincrement())

  name     String
  email    String @unique
  password String

  createdAt DateTime @default(now())
}
